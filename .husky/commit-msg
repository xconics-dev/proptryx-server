#!/usr/bin/env sh

# Ensure pnpm is available when hooks run from GUI apps (non-login shells).
export PATH="$HOME/Library/pnpm:$PATH"

if command -v pnpm >/dev/null 2>&1; then
	pnpm commitlint --edit "$1"
elif command -v corepack >/dev/null 2>&1; then
	corepack pnpm commitlint --edit "$1"
else
	echo "pnpm is required for commit-msg hook but was not found in PATH" >&2
	exit 127
fi
