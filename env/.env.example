# Local development env (single global file)
# Copy: cp env/.env.example env/.env

NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_HEALTHCHECKS=false
# Use a non-committed secret value in local env tooling (1Password/Doppler/etc.).
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Gateway
GATEWAY_NODE_ENV=development
GATEWAY_PORT=8000
GATEWAY_HOST_PORT=8000
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_FORMAT=pretty
GATEWAY_LOG_HEALTHCHECKS=false

# Auth
AUTH_NODE_ENV=development
AUTH_PORT=6001
AUTH_HOST_PORT=6001
AUTH_LOG_LEVEL=info
AUTH_LOG_FORMAT=pretty
AUTH_LOG_HEALTHCHECKS=false

# Property
PROPERTY_NODE_ENV=development
PROPERTY_PORT=6002
PROPERTY_HOST_PORT=6002
PROPERTY_LOG_LEVEL=info
PROPERTY_LOG_FORMAT=pretty
PROPERTY_LOG_HEALTHCHECKS=false

# Used for prod/dockploy routing docs
TRAEFIK_GATEWAY_HOST=proptryx.devmon.in
