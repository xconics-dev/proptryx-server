# Dockploy Swarm env template

GATEWAY_IMAGE=ghcr.io/your-org/proptryx-gateway:main
AUTH_IMAGE=ghcr.io/your-org/proptryx-auth:main
PROPERTY_IMAGE=ghcr.io/your-org/proptryx-property:main

NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Inject from Dockploy/CI secret store (do not commit real credentials).
# Optional PostgreSQL pool tuning query params:
# pool_max, pool_min, connect_timeout_ms, idle_timeout_ms, statement_timeout_ms,
# query_timeout_ms, max_uses, max_lifetime_seconds, keep_alive, keep_alive_initial_delay_ms
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?pool_max=30&pool_min=4&connect_timeout_ms=5000&idle_timeout_ms=10000&statement_timeout_ms=15000&query_timeout_ms=15000
REDIS_URL=redis://redis:6379

GATEWAY_PORT=8000
GATEWAY_HOST_PORT=8000
AUTH_PORT=6001
AUTH_HOST_PORT=6001
PROPERTY_PORT=6002
PROPERTY_HOST_PORT=6002

AUTH_SERVICE_URL=http://auth:6001
PROPERTY_SERVICE_URL=http://property:6002

BETTER_AUTH_SECRET=<set-a-long-random-secret>
BETTER_AUTH_URL=https://api.example.com/api/auth
BETTER_AUTH_API_KEY=<set-your-better-auth-api-key>

TRAEFIK_GATEWAY_HOST=api.example.com
