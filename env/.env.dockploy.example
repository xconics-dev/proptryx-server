# Dockploy Swarm env template

GATEWAY_IMAGE=ghcr.io/your-org/proptryx-gateway:main
AUTH_IMAGE=ghcr.io/your-org/proptryx-auth:main
PROPERTY_IMAGE=ghcr.io/your-org/proptryx-property:main

NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
LOG_HEALTHCHECKS=false
# Inject from Dockploy/CI secret store (do not commit real credentials).
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
NODE_OPTIONS=--max-old-space-size=768

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Gateway
GATEWAY_NODE_ENV=production
GATEWAY_PORT=8000
GATEWAY_HOST_PORT=8000
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_FORMAT=json
GATEWAY_LOG_HEALTHCHECKS=false
GATEWAY_NODE_OPTIONS=--max-old-space-size=512

# Auth
AUTH_NODE_ENV=production
AUTH_PORT=6001
AUTH_HOST_PORT=6001
AUTH_LOG_LEVEL=info
AUTH_LOG_FORMAT=json
AUTH_LOG_HEALTHCHECKS=false
AUTH_NODE_OPTIONS=--max-old-space-size=768

# Property
PROPERTY_NODE_ENV=production
PROPERTY_PORT=6002
PROPERTY_HOST_PORT=6002
PROPERTY_LOG_LEVEL=info
PROPERTY_LOG_FORMAT=json
PROPERTY_LOG_HEALTHCHECKS=false
PROPERTY_NODE_OPTIONS=--max-old-space-size=768

GATEWAY_REPLICAS=2
AUTH_REPLICAS=3
PROPERTY_REPLICAS=3

GATEWAY_CPU_LIMIT=1.00
GATEWAY_MEM_LIMIT=768M
GATEWAY_CPU_RESERVATION=0.25
GATEWAY_MEM_RESERVATION=256M

AUTH_CPU_LIMIT=1.50
AUTH_MEM_LIMIT=1024M
AUTH_CPU_RESERVATION=0.30
AUTH_MEM_RESERVATION=256M

PROPERTY_CPU_LIMIT=1.50
PROPERTY_MEM_LIMIT=1024M
PROPERTY_CPU_RESERVATION=0.30
PROPERTY_MEM_RESERVATION=256M

TRAEFIK_GATEWAY_HOST=api.example.com
