{
  "name": "@proptryx/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "dev": "tsx watch --env-file=../../env/.env src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "db:auth:generate": "set -a && . ../../env/.env && set +a && pnpm dlx auth@latest generate --config src/lib/auth/index.ts --output ../../packages/database/src/schemas/auth/schema.ts --yes",
    "db:auth:secret": "pnpm dlx auth@latest secret",
    "db:auth:info": "set -a && . ../../env/.env && set +a && pnpm dlx auth@latest info --config src/lib/auth/index.ts --json"
  },
  "dependencies": {
    "@better-auth/infra": "^0.1.8",
    "@better-auth/redis-storage": "^1.5.4",
    "@hono/node-server": "^1.19.11",
    "@proptryx/database": "workspace:*",
    "@proptryx/logger": "workspace:*",
    "@proptryx/notification": "workspace:*",
    "@proptryx/utils": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "better-auth": "^1.5.4",
    "better-auth-razorpay": "^2.0.5",
    "hono": "^4.12.5",
    "ioredis": "^5.10.0",
    "razorpay": "^2.9.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@proptryx/typescript-config": "workspace:*",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
