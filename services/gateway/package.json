{
  "name": "@proptryx/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --dir ../.. --filter \"@proptryx/gateway^...\" run build",
    "build": "tsup --config ../../tsup.config.ts",
    "predev": "pnpm run build:deps",
    "dev": "tsx watch --env-file=../../env/.env src/index.ts",
    "prestart": "pnpm run build:deps",
    "start": "node dist/index.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "pretype-check": "pnpm run build:deps",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.4",
    "@hono/node-server": "^1.19.12",
    "@proptryx/database": "workspace:*",
    "@proptryx/logger": "workspace:*",
    "@proptryx/utils": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "hono": "^4.12.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@proptryx/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
