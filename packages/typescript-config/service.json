{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Service (Node / Hono)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
