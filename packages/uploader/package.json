{
  "name": "@proptryx/uploader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./clients": {
      "types": "./src/clients.ts",
      "import": "./dist/clients.js",
      "default": "./dist/clients.js"
    },
    "./mime": {
      "types": "./src/mime.ts",
      "import": "./dist/mime.js",
      "default": "./dist/mime.js"
    },
    "./limits": {
      "types": "./src/limits.ts",
      "import": "./dist/limits.js",
      "default": "./dist/limits.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@better-upload/server": "^3.0.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@proptryx/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
