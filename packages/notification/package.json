{
  "name": "@proptryx/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && tsc --emitDeclarationOnly",
    "email:dev": "set -a && . ../../env/.env && set +a && email dev --dir src/email/templates --port \"${EMAIL_PREVIEW_PORT:-3005}\"",
    "email:export": "set -a && . ../../env/.env && set +a && email export --dir src/email/templates --outDir dist/email-preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@t3-oss/env-core": "^0.13.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^4.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@proptryx/typescript-config": "workspace:*",
    "@react-email/preview-server": "5.2.10",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "react-email": "^5.2.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
