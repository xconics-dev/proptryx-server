{
  "name": "@proptryx/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "lint": "biome lint ./src drizzle.config.ts",
    "lint:fix": "biome lint --write ./src drizzle.config.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo drizzle",
    "db:clean:artifacts": "sh -c 'if [ -d drizzle ]; then find drizzle -type f \\( -name \"._*\" -o -name \".__*\" \\) -delete; fi'",
    "db:generate": "pnpm run db:clean:artifacts && drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migration.ts",
    "db:push": "pnpm run db:clean:artifacts && drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "pnpm run db:clean:artifacts && drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@proptryx/typescript-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
