{
  "name": "@proptryx/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.2",
    "@hono/node-server": "^1.19.11",
    "@proptryx/database": "workspace:*",
    "@proptryx/static": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.4",
    "@t3-oss/env-core": "^0.13.10",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "unstorage": "^1.17.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@proptryx/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
