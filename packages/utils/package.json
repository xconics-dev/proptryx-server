{
  "name": "@proptryx/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@hono/node-server": "^2.0.0",
    "@proptryx/database": "workspace:*",
    "@proptryx/static": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.9",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "razorpay": "^2.9.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "unstorage": "^1.17.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@proptryx/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
