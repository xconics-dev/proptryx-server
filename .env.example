# Runtime mode
NODE_ENV=production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Container ports (inside Docker network)
GATEWAY_PORT=7000
AUTH_PORT=7001
PROPERTY_PORT=7002

# Host ports (public on server)
GATEWAY_HOST_PORT=7000
AUTH_HOST_PORT=7001
PROPERTY_HOST_PORT=7002

# Internal service discovery URLs used by gateway
AUTH_SERVICE_URL=http://auth:7001
PROPERTY_SERVICE_URL=http://property:7002
