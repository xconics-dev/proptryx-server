# Runtime mode
NODE_ENV=production

# Logging
PROD_LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_HEALTHCHECKS=false

# Optional per-service log-level overrides (fallback: PROD_LOG_LEVEL)
# GATEWAY_LOG_LEVEL=info
# AUTH_LOG_LEVEL=info
# PROPERTY_LOG_LEVEL=info

# Container ports (inside Docker network)
GATEWAY_PORT=8000
AUTH_PORT=6001
PROPERTY_PORT=6002

# Host ports (public on server)
GATEWAY_HOST_PORT=8000
AUTH_HOST_PORT=6001
PROPERTY_HOST_PORT=6002

# Internal service discovery URLs used by gateway
AUTH_SERVICE_URL=http://auth:6001
PROPERTY_SERVICE_URL=http://property:6002
