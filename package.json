{
  "name": "proptryx",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "build:gateway": "turbo run build --filter=@proptryx/gateway",
    "build:auth": "turbo run build --filter=@proptryx/auth",
    "build:kernel": "turbo run build --filter=@proptryx/kernel",
    "build:company": "turbo run build --filter=@proptryx/company",
    "dev:build-deps": "pnpm --filter @proptryx/logger run build && pnpm --filter @proptryx/database run build && pnpm --filter @proptryx/static run build && pnpm --filter @proptryx/utils run build && pnpm --filter @proptryx/notification run build",
    "dev": "turbo run dev --filter=@proptryx/gateway --filter=@proptryx/auth --filter=@proptryx/kernel --filter=@proptryx/company",
    "dev:email": "pnpm --filter @proptryx/notification run email:dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:gateway": "turbo run lint --filter=@proptryx/gateway",
    "lint:auth": "turbo run lint --filter=@proptryx/auth",
    "lint:kernel": "turbo run lint --filter=@proptryx/kernel",
    "lint:company": "turbo run lint --filter=@proptryx/company",
    "type-check": "turbo run type-check",
    "type-check:gateway": "turbo run type-check --filter=@proptryx/gateway",
    "type-check:auth": "turbo run type-check --filter=@proptryx/auth",
    "type-check:kernel": "turbo run type-check --filter=@proptryx/kernel",
    "type-check:company": "turbo run type-check --filter=@proptryx/company",
    "clean": "turbo run clean",
    "clean:full": "turbo run clean && rm -rf node_modules",
    "clean:gateway": "turbo run clean --filter=@proptryx/gateway",
    "clean:auth": "turbo run clean --filter=@proptryx/auth",
    "clean:kernel": "turbo run clean --filter=@proptryx/kernel",
    "clean:company": "turbo run clean --filter=@proptryx/company",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docker:clean:appledouble": "node ./scripts/clean-docker-appledouble.mjs",
    "predocker:build": "pnpm run docker:clean:appledouble",
    "docker:up": "docker compose --env-file env/.env -f docker/docker-compose.yml up",
    "docker:up:d": "docker compose --env-file env/.env -f docker/docker-compose.yml up -d",
    "predocker:up:build": "pnpm run docker:clean:appledouble",
    "docker:up:build": "docker compose --env-file env/.env -f docker/docker-compose.yml up --build",
    "predocker:up:build:d": "pnpm run docker:clean:appledouble",
    "docker:up:build:d": "docker compose --env-file env/.env -f docker/docker-compose.yml up --build -d",
    "docker:down": "docker compose --env-file env/.env -f docker/docker-compose.yml down",
    "docker:down:v": "docker compose --env-file env/.env -f docker/docker-compose.yml down -v",
    "docker:logs": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f",
    "docker:logs:gateway": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f gateway",
    "docker:logs:auth": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f auth",
    "docker:logs:kernel": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f kernel",
    "docker:logs:company": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f company",
    "docker:ps": "docker compose --env-file env/.env -f docker/docker-compose.yml ps",
    "docker:build": "docker compose --env-file env/.env -f docker/docker-compose.yml build",
    "predocker:prod:build": "pnpm run docker:clean:appledouble",
    "docker:prod:up": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up",
    "docker:prod:up:d": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up -d",
    "predocker:prod:up:build": "pnpm run docker:clean:appledouble",
    "docker:prod:up:build": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up --build",
    "predocker:prod:up:build:d": "pnpm run docker:clean:appledouble",
    "docker:prod:up:build:d": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml down",
    "docker:prod:down:v": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml down -v",
    "docker:prod:logs": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f",
    "docker:prod:logs:gateway": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f gateway",
    "docker:prod:logs:auth": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f auth",
    "docker:prod:logs:kernel": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f kernel",
    "docker:prod:logs:company": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f company",
    "docker:prod:ps": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml ps",
    "docker:prod:build": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml build",
    "docker:size": "bash scripts/docker-image-size.sh",
    "docker:size:build": "bash scripts/docker-image-size.sh --build",
    "health:gateway": "curl -s http://localhost:8000/health | jq",
    "health:auth": "curl -s http://localhost:8000/api/auth/health | jq",
    "health:kernel": "curl -s http://localhost:8000/api/kernel/health | jq",
    "health:company": "curl -s http://localhost:8000/api/company/health | jq",
    "redis:cleanup:legacy": "pnpm --filter @proptryx/auth exec sh -c 'set -a; . \"$INIT_CWD/env/.env\"; set +a; node --import tsx \"$INIT_CWD/scripts/redis-cleanup.ts\"'",
    "redis:cleanup:legacy:apply": "pnpm --filter @proptryx/auth exec sh -c 'set -a; . \"$INIT_CWD/env/.env\"; set +a; node --import tsx \"$INIT_CWD/scripts/redis-cleanup.ts\" --execute'",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "deps:check": "NO_UPDATE_NOTIFIER=1 ncu --workspaces --root",
    "deps:size": "tsx scripts/deps-size-report.ts",
    "deps:bump": "NO_UPDATE_NOTIFIER=1 ncu -u --workspaces --root && pnpm install --no-frozen-lockfile",
    "db:generate": "pnpm --filter @proptryx/database db:generate",
    "db:migrate": "pnpm --filter @proptryx/database db:migrate",
    "db:push": "pnpm --filter @proptryx/database db:push",
    "db:studio": "pnpm --filter @proptryx/database db:studio"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,css,scss,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^25.7.0",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "npm-check-updates": "^22.2.0",
    "pg": "^8.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "ultracite": "^7.7.0"
  }
}
