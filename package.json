{
  "name": "proptryx",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "build:gateway": "turbo run build --filter=@proptryx/gateway",
    "build:auth": "turbo run build --filter=@proptryx/auth",
    "build:property": "turbo run build --filter=@proptryx/property",
    "dev": "pnpm --filter @proptryx/logger run build && turbo run dev --filter=@proptryx/gateway --filter=@proptryx/auth --filter=@proptryx/property",
    "dev:gateway": "turbo run dev --filter=@proptryx/gateway",
    "dev:auth": "turbo run dev --filter=@proptryx/auth",
    "dev:property": "turbo run dev --filter=@proptryx/property",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:gateway": "turbo run lint --filter=@proptryx/gateway",
    "lint:auth": "turbo run lint --filter=@proptryx/auth",
    "lint:property": "turbo run lint --filter=@proptryx/property",
    "type-check": "turbo run type-check",
    "type-check:gateway": "turbo run type-check --filter=@proptryx/gateway",
    "type-check:auth": "turbo run type-check --filter=@proptryx/auth",
    "type-check:property": "turbo run type-check --filter=@proptryx/property",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:gateway": "turbo run clean --filter=@proptryx/gateway",
    "clean:auth": "turbo run clean --filter=@proptryx/auth",
    "clean:property": "turbo run clean --filter=@proptryx/property",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:logs:gateway": "docker compose logs -f gateway",
    "docker:logs:auth": "docker compose logs -f auth",
    "docker:logs:property": "docker compose logs -f property",
    "docker:ps": "docker compose ps",
    "docker:build": "docker compose build",
    "health:gateway": "curl -s http://localhost:3000/health | jq",
    "health:auth": "curl -s http://localhost:3000/api/auth/health | jq",
    "health:property": "curl -s http://localhost:3000/api/property/health | jq",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,css,scss,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/node": "^20.19.37",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "tsup": "^8.5.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "ultracite": "^4.1.10"
  }
}
